# Copy to .env.local (gitignored) and fill in. Read only by the server; nothing here reaches the browser.

GEMINI_API_KEY="your-key-here"

# Optional settings (defaults shown). Keep comments on their own lines:
# systemd's EnvironmentFile does not strip trailing comments.

# Port the server listens on.
PORT=3000
# 0.0.0.0 = reachable on the LAN; 127.0.0.1 when only a local reverse proxy should reach it.
HOST=0.0.0.0
# Number of reverse proxies in front of the app (Caddy, nginx, Cloudflare Tunnel); 0 = none.
TRUST_PROXY=0
# Verse requests allowed per client IP per minute.
RATE_LIMIT_PER_MINUTE=10
